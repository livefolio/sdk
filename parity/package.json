{
  "name": "@livefolio/parity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "v0.4 parity gate — proves tactical/v1 produces the same allocation history as v0.3 on yfinance fixtures.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "dependencies": {
    "@livefolio/sdk": "file:..",
    "@livefolio/sdk-v3": "npm:@livefolio/sdk@0.3.7",
    "@livefolio/yfinance": "file:../../yfinance",
    "@livefolio/yfinance-browser": "file:../../yfinance/browser",
    "nanoid": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3"
  }
}
